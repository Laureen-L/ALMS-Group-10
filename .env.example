# ---- Database (Prisma) ----
DATABASE_URL=

# ---- Supabase (backend/) ----
# Project URL and anon key from Supabase Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Backend server ----
PORT=5001

# ---- Termii SMS (optional) ----
# Only needed for POST /api/admin/send-overdue-reminders.
# Without it that endpoint returns 503 and no SMS is sent.
TERMII_API_KEY=

# ---- Frontend (frontend/.env) ----
# VITE_USE_MOCK=false switches the UI from mock data to the real backend.
# Any other value (or unset) keeps mock mode.
VITE_USE_MOCK=false
VITE_API_BASE_URL=http://localhost:5001/api
