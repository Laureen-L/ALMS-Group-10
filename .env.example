# ---- Database (Prisma) ----
DATABASE_URL=

# ---- Supabase (backend/) ----
# Project URL and keys from Supabase Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The backend's database client runs on this key, because RLS on `users` hides
# that table from the anon key — roles collapse to "student" and the member
# list comes back empty. Server-side only: never copy it into a VITE_* var.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Backend server ----
PORT=5001

# Where the confirmation and password-reset links in Supabase's emails point.
# Defaults to http://localhost:5173 when unset. Whatever you put here must also
# be listed under Authentication > URL Configuration > Redirect URLs in the
# Supabase dashboard, or Supabase ignores it and falls back to Site URL —
# which drops the recovery token and makes password reset do nothing.
FRONTEND_URL=http://localhost:5173

# ---- Termii SMS (optional) ----
# Only needed for POST /api/admin/send-overdue-reminders.
# Without it that endpoint returns 503 and no SMS is sent.
TERMII_API_KEY=

# ---- Frontend (frontend/.env) ----
# VITE_USE_MOCK=false switches the UI from mock data to the real backend.
# Any other value (or unset) keeps mock mode.
VITE_USE_MOCK=false
VITE_API_BASE_URL=http://localhost:5001/api
