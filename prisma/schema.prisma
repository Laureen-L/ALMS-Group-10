// =============================================================
// ALMS — Automated Library Management System
// Prisma Schema v1.0 | Supabase PostgreSQL
// Aligned to SRS v1.0 & Data Dictionary v1.0
// KNUST Computer Science Department — Group 10
// =============================================================


generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
 }

// =============================================================
// ENUM TYPES
// Must be created before running migrations.
// These map directly to the three PostgreSQL ENUM types
// defined in the Data Dictionary §2.
// =============================================================





/// FR-03: Role assigned at registration. Defaults to 'student'.
/// Checked on every API request via JWT claim (FR-04).
enum user_role {
  student
  librarian
  admin
}

/// Tracks the lifecycle of a loan record (FR-09, FR-11, FR-18).
/// 'overdue' is set by the daily pg_cron job, not in real-time.
enum loan_status {
  active
  returned
  overdue
}

/// Tracks fine state for FR-18 overdue reporting.
/// Payment processing is out of scope for v1.0 (SRS §6).
/// Column retained for future billing integration.
enum fine_status {
  unpaid
  paid
  waived
}

// =============================================================
// TABLE: users
// SRS Refs: FR-01, FR-02, FR-03, FR-04
// Central authentication and role table. Every system actor
// (student, librarian, administrator) is a single row here.
// Supports up to 5,000 registered members (NFR Scalability).
// =============================================================

model users {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Required at registration (FR-01). Max 100 chars.
  full_name     String    @db.VarChar(100)

  /// Used as login credential (FR-02). Must be unique across all users.
  /// Format validated at the Express.js layer, not in the DB.
  email         String    @unique @db.VarChar(100)

  /// bcrypt hash of the user password (cost factor >= 12).
  /// Plain-text passwords are NEVER stored. Satisfies NFR Security.
  password_hash String    @db.Text

  /// Optional contact number, set by the member on their profile page.
  /// Read by the overdue SMS reminder job. Nullable — never required to borrow.
  phone         String?   @db.VarChar(20)

  /// PostgreSQL ENUM. Assigned on registration (FR-03). Defaults to 'student'.
  role          user_role @default(student)

  /// Soft-delete / account suspension flag.
  /// FALSE disables login without physically deleting records.
  is_active     Boolean   @default(true)

  /// Notification and display preferences set on the Settings screen.
  /// JSONB rather than one column per toggle: these are UI preferences
  /// that keep changing and are never queried or joined on, so a new
  /// toggle should not need a migration.
  preferences   Json      @default("{}") @db.JsonB

  created_at    DateTime  @default(now()) @db.Timestamptz()

  /// Maintained by trigger trg_users_updated_at.
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz()

  // ------------------------------------------------------------------
  // RELATIONS
  // ------------------------------------------------------------------

  /// Books this user added to the catalogue (FR-08).
  books_added      books[]          @relation("BookAddedBy")

  /// Borrow records where this user is the borrowing member.
  borrows          borrow_records[] @relation("BorrowUser")

  /// Borrow records where this user is the processing librarian/admin.
  loans_processed  borrow_records[] @relation("BorrowProcessedBy")

  /// Fine records owed by this user (FR-18).
  fines            fines[]          @relation("FineUser")

  /// Books this user has saved to their favorites.
  favorites        favorites[]      @relation("FavoriteUser")

  /// In-app notices addressed to this user (overdue reminders, etc.).
  notifications    notifications[]  @relation("NotificationUser")

  /// Governance actions this user performed (role changes, deletions).
  audit_entries    audit_log[]      @relation("AuditActor")

  /// Books this user withdrew from circulation.
  books_withdrawn  books[]          @relation("BookWithdrawnBy")

  /// Policy changes this user made. At most one row points here.
  settings_updated system_settings[] @relation("SettingsUpdatedBy")

  // ------------------------------------------------------------------
  // INDEXES (Data Dictionary §2.1)
  // ------------------------------------------------------------------
  @@index([role],      name: "idx_users_role")       // Fast role filter for admin user management (FR-16)
  @@index([is_active], name: "idx_users_is_active")  // Speeds up active-user queries at login
}

// =============================================================
// TABLE: books
// SRS Refs: FR-05, FR-06, FR-07, FR-08
// Master catalogue of all library books. available_quantity is
// updated by trigger on every borrow/return (FR-12), enabling
// real-time availability checks without a JOIN.
// Supports up to 10,000 records (NFR Scalability).
// =============================================================

model books {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Full title. Required (FR-07). Supports full-text search (FR-05/FR-06).
  title String @db.VarChar(255)

  /// Author name(s). Required (FR-07). Multiple authors separated by semicolons.
  author String @db.VarChar(255)

  /// ISBN-10 or ISBN-13. Unique when not NULL (partial index).
  /// NULL permitted for items without an ISBN.
  isbn String? @unique @db.VarChar(13)

  /// Genre / subject classification (e.g. 'Computer Science', 'Fiction').
  /// Supports FR-06 filter by genre. Stored as a column per DD §8.2.
  genre String? @db.VarChar(100)

  /// Total physical copies owned by the library. Required (FR-07).
  /// CHECK: quantity >= 0 — enforced via raw SQL migration.
  quantity Int @default(1) @db.SmallInt

  /// Copies currently available for borrowing.
  /// Updated by trigger trg_update_availability on borrow/return (FR-12).
  /// CHECK: available_quantity >= 0 AND available_quantity <= quantity.
  available_quantity Int @default(1) @db.SmallInt

  /// Librarian or admin who added this record (FR-08).
  /// SET NULL when the staff account is deleted — book record is preserved.
  added_by String? @db.Uuid

  /// Soft removal from circulation. NULL means the title is live.
  ///
  /// Exists so librarians never need DELETE on a catalogue row:
  /// borrow_records references books with onDelete: Restrict, so a real
  /// delete either fails on any title that was ever borrowed, or destroys
  /// the loan history the library is meant to keep.
  withdrawn_at DateTime? @db.Timestamptz()

  /// Staff member who withdrew it.
  withdrawn_by String? @db.Uuid

  created_at DateTime @default(now()) @db.Timestamptz()

  /// Maintained by trigger trg_books_updated_at.
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz()

  // ------------------------------------------------------------------
  // RELATIONS
  // ------------------------------------------------------------------

  added_by_user     users?        @relation("BookAddedBy", fields: [added_by], references: [id], onDelete: SetNull)
  withdrawn_by_user users?        @relation("BookWithdrawnBy", fields: [withdrawn_by], references: [id], onDelete: SetNull)
  borrow_records borrow_records[]

  /// Members who have saved this book to their favorites.
  favorites      favorites[]

  // ------------------------------------------------------------------
  // INDEXES (Data Dictionary §2.2)
  // ------------------------------------------------------------------
  @@index([title],              name: "idx_books_title")     // Title-based search/filter (FR-06)
  @@index([author],             name: "idx_books_author")    // Author-based search/filter (FR-06)
  @@index([genre],              name: "idx_books_genre")     // Genre filter (FR-06)
  @@index([available_quantity], name: "idx_books_available") // Availability filter (FR-06)
}

// =============================================================
// TABLE: borrow_records
// SRS Refs: FR-09, FR-10, FR-11, FR-12, FR-13, FR-14, FR-15,
//           FR-17, FR-18
// Core loan tracking table. Created on borrow (FR-09).
// due_date set by trigger to borrow_date + 14 days (FR-10).
// The 5-book limit (FR-13) is enforced at the API layer (DD §8.3).
// =============================================================

model borrow_records {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The borrowing member.
  /// RESTRICT delete — cannot delete a user who has loan records.
  user_id String @db.Uuid

  /// The book title borrowed.
  /// RESTRICT delete — cannot delete a book that has loan history.
  book_id String @db.Uuid

  /// Librarian or admin who processed the loan. NULL if self-service.
  /// SET NULL when the staff account is deleted — loan record is preserved.
  processed_by String? @db.Uuid

  /// Date the book was borrowed.
  borrow_date DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date

  /// Return deadline. Set by trigger trg_set_due_date to borrow_date + 14 days (FR-10).
  /// CHECK: due_date > borrow_date — enforced via raw SQL migration.
  due_date DateTime @db.Date

  /// Actual return date (FR-11). NULL while the book is still on loan.
  /// CHECK: return_date >= borrow_date — enforced via raw SQL migration.
  return_date DateTime? @db.Date

  /// ENUM: 'active' / 'returned' / 'overdue'.
  /// 'overdue' is set by the daily pg_cron job (DD §7).
  /// Powers FR-14 (dashboard), FR-17 (admin view), FR-18 (overdue report).
  status loan_status @default(active)

  /// Optional librarian notes at time of borrowing or return.
  notes String? @db.Text

  /// Extensions granted on this loan, checked against
  /// system_settings.max_renewals. Every existing loan starts at 0,
  /// which is correct — none of them has ever been renewed.
  renewal_count Int @default(0) @db.SmallInt

  created_at DateTime @default(now()) @db.Timestamptz()

  /// Maintained by trigger trg_borrow_updated_at.
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz()

  // ------------------------------------------------------------------
  // RELATIONS
  // ------------------------------------------------------------------

  borrowing_user    users  @relation("BorrowUser",        fields: [user_id],      references: [id], onDelete: Restrict)
  book              books  @relation(                      fields: [book_id],      references: [id], onDelete: Restrict)
  processing_staff  users? @relation("BorrowProcessedBy", fields: [processed_by], references: [id], onDelete: SetNull)

  /// One fine record may exist per overdue loan (FR-18).
  fine fines?

  /// In-app notices raised about this loan (e.g. overdue reminders).
  notifications notifications[]

  // ------------------------------------------------------------------
  // INDEXES (Data Dictionary §2.3)
  // ------------------------------------------------------------------
  @@index([user_id],         name: "idx_br_user_id")     // Member borrowing history (FR-15)
  @@index([book_id],         name: "idx_br_book_id")     // All loans for a specific book (FR-17)
  @@index([status],          name: "idx_br_status")      // Overdue loan filter (FR-18)
  @@index([due_date],        name: "idx_br_due_date")    // Used by daily cron job
  @@index([user_id, status], name: "idx_br_user_status") // Member dashboard (FR-14) + 5-book limit check (FR-13)
}

// =============================================================
// TABLE: favorites
// Books a member has saved for later. Purely a convenience list —
// it carries no lending semantics and nothing else depends on it,
// so both foreign keys CASCADE on delete.
// =============================================================

model favorites {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The member who saved the book.
  user_id String @db.Uuid

  /// The saved book.
  book_id String @db.Uuid

  created_at DateTime @default(now()) @db.Timestamptz()

  // ------------------------------------------------------------------
  // RELATIONS
  // ------------------------------------------------------------------

  user users @relation("FavoriteUser", fields: [user_id], references: [id], onDelete: Cascade)
  book books @relation(fields: [book_id], references: [id], onDelete: Cascade)

  // ------------------------------------------------------------------
  // CONSTRAINTS & INDEXES
  // ------------------------------------------------------------------
  @@unique([user_id, book_id], name: "favorites_user_id_book_id_key") // one row per member/book
  @@index([user_id], name: "idx_favorites_user_id")                   // list a member's favorites
}

// =============================================================
// TABLE: notifications
// In-app notices delivered inside ALMS itself.
//
// Overdue reminders were SMS-only, which made the whole feature
// depend on a Termii API key and an approved sender ID. This table
// is the channel that always works: nothing external is involved,
// so a member is still told their book is late when SMS is not
// available, and SMS becomes an addition rather than the only path.
// =============================================================

model notifications {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The member the notice is addressed to.
  /// CASCADE delete — a notice is a pointer, not a record to preserve.
  user_id String @db.Uuid

  /// Headline shown in the notification list.
  title String @db.VarChar(150)

  /// Full message text. Mirrors the SMS wording where both are sent.
  body String @db.Text

  /// What produced this notice ('overdue_reminder', 'general', …).
  /// VARCHAR rather than an ENUM so a new kind needs no ALTER TYPE.
  type String @default("general") @db.VarChar(30)

  /// The loan this notice concerns, when there is one.
  /// SET NULL — the notice still happened even if the loan record goes.
  borrow_id String? @db.Uuid

  /// NULL while unread. Doubles as the unread flag, so there is no
  /// separate boolean that could drift out of step with the timestamp.
  read_at DateTime? @db.Timestamptz()

  created_at DateTime @default(now()) @db.Timestamptz()

  // ------------------------------------------------------------------
  // RELATIONS
  // ------------------------------------------------------------------

  user          users           @relation("NotificationUser", fields: [user_id], references: [id], onDelete: Cascade)
  borrow_record borrow_records? @relation(fields: [borrow_id], references: [id], onDelete: SetNull)

  // ------------------------------------------------------------------
  // INDEXES
  // ------------------------------------------------------------------
  @@index([user_id, created_at], name: "idx_notifications_user_created") // the inbox, newest first
  @@index([user_id],             name: "idx_notifications_unread")       // partial (read_at IS NULL) in SQL — unread badge
}

// =============================================================
// TABLE: fines
// SRS Refs: FR-18
// Records fine amounts for overdue loans. Created automatically
// by trigger trg_auto_overdue_fine when a loan transitions to
// 'overdue'. Fine payment / billing integration is OUT OF SCOPE
// for v1.0 (SRS §6). The status column is retained for future use.
// =============================================================

model fines {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The overdue loan that generated this fine.
  /// UNIQUE — one fine record per overdue loan.
  /// RESTRICT delete — cannot delete a loan with an associated fine.
  borrow_id String @unique @db.Uuid

  /// The member who owes the fine.
  /// Denormalised from borrow_records for direct query performance.
  /// RESTRICT delete — fine record is preserved even if user account is deactivated.
  user_id String @db.Uuid

  /// Total fine amount in GHS. Calculated at time of overdue detection.
  /// Formula: days_overdue × 0.50 GHS (set by trigger trg_auto_overdue_fine).
  /// CHECK: amount > 0 — enforced via raw SQL migration.
  amount Decimal @db.Decimal(8, 2)

  /// ENUM: 'unpaid' / 'paid' / 'waived'.
  /// Payment processing is out of scope for v1.0 but the column
  /// is retained for future billing integration (DD §8.5).
  status fine_status @default(unpaid)

  issued_at DateTime @default(now()) @db.Timestamptz()

  /// Admin or librarian notes (e.g. reason for waiver).
  notes String? @db.Text

  // ------------------------------------------------------------------
  // RELATIONS
  // ------------------------------------------------------------------

  borrow_record borrow_records @relation(fields: [borrow_id], references: [id], onDelete: Restrict)
  user          users          @relation("FineUser", fields: [user_id], references: [id], onDelete: Restrict)

  // ------------------------------------------------------------------
  // INDEXES (Data Dictionary §2.4)
  // ------------------------------------------------------------------
  @@index([user_id], name: "idx_fines_user_id") // All fines for a member (FR-18)
  @@index([status],  name: "idx_fines_status")  // Filters unpaid fines for reporting
}

// =============================================================
// TABLE: system_settings
//
// Library policy, held in the database rather than in code.
//
// The loan period (14 days) and the borrow limit (5) were constants
// in borrowController.js, so changing library policy meant editing
// source and redeploying. An administrator sets them here instead.
//
// A singleton: the CHECK constraint on the primary key in SQL means
// there can only ever be one row, so the backend reads it with
// .eq('id', 1) and never has to decide which row is the live one.
// =============================================================

model system_settings {
  /// Always 1. CHECK ("id" = 1) in SQL enforces the singleton.
  id Int @id @default(1) @db.SmallInt

  /// FR-12: how long a new loan runs.
  loan_period_days Int @default(14) @db.SmallInt

  /// FR-09: how many books one member may hold at once.
  max_active_borrows Int @default(5) @db.SmallInt

  /// How many times a member may extend one loan, and by how long.
  max_renewals Int @default(2) @db.SmallInt
  renewal_period_days Int @default(7) @db.SmallInt

  /// Fine accrual, in GHS per day late. Matches fines.amount scale.
  fine_per_day Decimal @default(0.50) @db.Decimal(8, 2)

  /// Days past the due date before a fine starts accruing.
  fine_grace_days Int @default(0) @db.SmallInt

  /// How far ahead the "due soon" desk queue looks.
  due_soon_days Int @default(3) @db.SmallInt

  /// Below this many available copies, a title shows on low stock.
  low_stock_threshold Int @default(2) @db.SmallInt

  /// Who last changed policy. audit_log carries the full history;
  /// this is the quick answer for the settings screen.
  /// SET NULL — policy outlives the administrator who set it.
  updated_by String? @db.Uuid

  updated_at DateTime @default(now()) @db.Timestamptz()

  // ------------------------------------------------------------------
  // RELATIONS
  // ------------------------------------------------------------------

  updated_by_user users? @relation("SettingsUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)
}

// =============================================================
// TABLE: audit_log
//
// Who did what, to what, and when.
//
// Role promotions, deactivations and catalogue deletions previously
// left no trace of an actor — borrow_records.processed_by was the
// only accountability in the system. This is the record that
// separates an administrator from a librarian.
//
// Append-only. Nothing in the application updates or deletes a row:
// a corrected mistake is a second entry, not an edited one.
// =============================================================

model audit_log {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Who did it. SET NULL on delete, because the entry must outlive
  /// the actor — "nobody did this" is a worse answer than "an account
  /// that no longer exists did this".
  actor_id String? @db.Uuid

  /// Denormalised copies captured at write time. actor_id goes NULL
  /// when an account is removed, and a log that then reads "someone
  /// changed a role" is worthless. These are what keep the entry
  /// legible years later.
  actor_email String? @db.VarChar(100)
  actor_role  String? @db.VarChar(20)

  /// Dotted verb: 'member.role_changed', 'book.deleted',
  /// 'settings.updated', 'fine.waived'. VARCHAR rather than an ENUM
  /// so a new action never needs an ALTER TYPE, which Postgres
  /// cannot run inside a transaction.
  action String @db.VarChar(60)

  /// What it was done to: 'user' | 'book' | 'loan' | 'fine' | 'settings'.
  entity_type String  @db.VarChar(40)
  entity_id   String? @db.Uuid

  /// Human-readable name of the target, also captured at write time:
  /// a deleted book's title is the only thing that makes its deletion
  /// entry mean anything.
  entity_label String? @db.VarChar(255)

  /// Before/after values, free-form per action. JSONB rather than
  /// columns because every action carries different fields.
  details Json? @db.JsonB

  created_at DateTime @default(now()) @db.Timestamptz()

  // ------------------------------------------------------------------
  // RELATIONS
  // ------------------------------------------------------------------

  actor users? @relation("AuditActor", fields: [actor_id], references: [id], onDelete: SetNull)

  // ------------------------------------------------------------------
  // INDEXES
  // ------------------------------------------------------------------
  @@index([created_at],                       name: "idx_audit_log_created") // the whole log, newest first
  @@index([actor_id, created_at],             name: "idx_audit_log_actor")   // one administrator's actions
  @@index([entity_type, entity_id, created_at], name: "idx_audit_log_entity") // one book's / one member's history
}
