# ---- Database (Prisma) ----
DATABASE_URL=

# ---- Supabase (backend/) ----
# Project URL and keys from Supabase Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The backend's database client runs on this key, because RLS on `users` hides
# that table from the anon key — roles collapse to "student" and the member
# list comes back empty. Server-side only: never copy it into a VITE_* var.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Backend server ----
PORT=5001

# Where the confirmation and password-reset links in Supabase's emails point.
# Defaults to http://localhost:5173 when unset. Whatever you put here must also
# be listed under Authentication > URL Configuration > Redirect URLs in the
# Supabase dashboard, or Supabase ignores it and falls back to Site URL —
# which drops the recovery token and makes password reset do nothing.
FRONTEND_URL=http://localhost:5173

# ---- Termii SMS (optional) ----
# Genuinely optional. POST /api/admin/send-overdue-reminders works without it:
# every overdue member gets an in-app notification either way, and this key
# only adds SMS on top. The response reports smsConfigured: false when unset.
#
# The key alone is not enough to make a message arrive. Termii also requires
# the sender ID in reminderController.js (ALMS-KNUST) to be registered and
# approved on your Termii dashboard, and the account wallet to hold credit.
# An unapproved sender ID is the usual reason a send "succeeds" silently.
#
# Numbers are stored however the member typed them and converted to Termii's
# bare international format at send time by src/utils/phone.js — nothing here
# needs a country code.
TERMII_API_KEY=

# ---- Frontend (frontend/.env) ----
# VITE_USE_MOCK=false switches the UI from mock data to the real backend.
# Any other value (or unset) keeps mock mode.
VITE_USE_MOCK=false
VITE_API_BASE_URL=http://localhost:5001/api
